# ============================================
# Agent UAM — variables d'environnement
# Copier en .env et compléter. Ne jamais versionner le .env.
# ============================================

# ── LLM (obligatoire) ────────────────────────────────────────────────────
OPENROUTER_API_KEY=sk-or-v1-...
UAM_LLM_PROVIDER=openrouter
UAM_LLM_MODEL=openai/gpt-4o-mini
UAM_LLM_MAX_TOKENS=500          # réponses courtes, adaptées au web et à WhatsApp

# ── Recherche documentaire ───────────────────────────────────────────────
UAM_SIMILARITY_K=8
UAM_MAX_TOOL_ITERATIONS=3

# ── Base de scolarité ────────────────────────────────────────────────────
UAM_DB_TYPE=sqlite
UAM_DB_PATH=./database/scolarite_uam.db

# ── WhatsApp Business Cloud API (optionnel — voir WHATSAPP.md) ───────────
# Sans ces variables, le site fonctionne normalement et le webhook reste fermé.
WHATSAPP_VERIFY_TOKEN=          # chaîne libre, à recopier dans la console Meta
WHATSAPP_ACCESS_TOKEN=          # token de l'app Meta (temporaire : 24 h)
WHATSAPP_PHONE_NUMBER_ID=       # identifiant du numéro expéditeur
WHATSAPP_APP_SECRET=            # secret de l'app, valide la signature des webhooks

# ── LangSmith (optionnel — traces d'exécution) ───────────────────────────
LANGSMITH_TRACING=false
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=agent-uam
