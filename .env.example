# ============================================
# Agent UAM — variables d'environnement
# Copier en .env et compléter. Ne jamais versionner le .env.
# ============================================

# ── LLM (obligatoire) ────────────────────────────────────────────────────
OPENROUTER_API_KEY=sk-or-v1-...
UAM_LLM_PROVIDER=openrouter
UAM_LLM_MODEL=openai/gpt-4o-mini
UAM_LLM_MAX_TOKENS=500          # réponses courtes, adaptées au web et à WhatsApp
UAM_LLM_TEMPERATURE=0.3         # créativité du LLM (0=déterministe, 1=créatif) — défaut 0.3
UAM_LLM_TIMEOUT=60              # délai d'attente réponse LLM en secondes — défaut 60

# ── Recherche documentaire ───────────────────────────────────────────────
UAM_SIMILARITY_K=8
UAM_MAX_TOOL_ITERATIONS=3
UAM_DOCUMENTS_DIR=./documents_uam   # dossier des PDF/TXT UAM à indexer — défaut ./documents_uam
UAM_VECTORSTORE_DIR=./vectorstore   # persistance de l'index FAISS — défaut ./vectorstore
UAM_CHUNK_SIZE=1000                 # taille des chunks de découpage documentaire — défaut 1000
UAM_CHUNK_OVERLAP=200               # chevauchement entre chunks, doit être < UAM_CHUNK_SIZE — défaut 200

# ── Base de scolarité ────────────────────────────────────────────────────
UAM_DB_TYPE=sqlite
UAM_DB_PATH=./database/scolarite_uam.db
# Les 6 variables suivantes ne sont lues que si UAM_DB_TYPE=postgresql|mysql :
UAM_DB_HOST=localhost                    # hôte de la base — défaut localhost
UAM_DB_PORT=5432                         # port de la base — défaut 5432
UAM_DB_NAME=uam_db                       # nom de la base — défaut uam_db
UAM_DB_USER=postgres                     # utilisateur de la base — défaut postgres
UAM_DB_PASSWORD=                         # mot de passe de la base — défaut vide
UAM_DB_CONNECTION_STRING=                # chaîne de connexion complète, prioritaire si définie — défaut absent

# ── Dossiers et fichiers applicatifs ─────────────────────────────────────
UAM_EXPORTS_DIR=./exports           # dossier des exports générés — défaut ./exports
UAM_LOGS_DIR=./logs                 # dossier des logs applicatifs — défaut ./logs
UAM_MEMORY_FILE=./user_memory.json  # mémoire utilisateur au format JSON — défaut ./user_memory.json
UAM_MEMORY_DB=./user_memory.db      # mémoire utilisateur au format SQLite — défaut ./user_memory.db
UAM_METRICS_DB=./metrics.db         # base des métriques de temps de réponse — défaut ./metrics.db

# ── Sécurité et limites ──────────────────────────────────────────────────
UAM_MAX_INPUT_LENGTH=2000     # longueur max d'un message utilisateur (caractères) — défaut 2000
UAM_MAX_RETRIES=3             # nombre de tentatives en cas d'échec — défaut 3
UAM_RATE_LIMIT=60             # requêtes max par minute — défaut 60

# ── Interface Streamlit ──────────────────────────────────────────────────
UAM_STREAMLIT_HOST=localhost  # hôte d'écoute Streamlit — défaut localhost
UAM_STREAMLIT_PORT=8501       # port d'écoute Streamlit — défaut 8501

# ── Persistance des sessions ──────────────────────────────────────────────
# "sqlite" (défaut, survit au redémarrage) ou "memory"
UAM_CHECKPOINTER=sqlite
UAM_CHECKPOINT_DB=./database/checkpoints.db

# ── WhatsApp Business Cloud API (optionnel — voir WHATSAPP.md) ───────────
# Sans ces variables, le site fonctionne normalement et le webhook reste fermé.
WHATSAPP_VERIFY_TOKEN=          # chaîne libre, à recopier dans la console Meta
WHATSAPP_ACCESS_TOKEN=          # token de l'app Meta (temporaire : 24 h)
WHATSAPP_PHONE_NUMBER_ID=       # identifiant du numéro expéditeur
WHATSAPP_APP_SECRET=            # secret de l'app, valide la signature des webhooks

# ── LangSmith (optionnel — traces d'exécution) ───────────────────────────
LANGSMITH_TRACING=false
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=agent-uam
